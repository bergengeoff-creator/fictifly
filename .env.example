# Copy to .env.local for local development. Never commit real values.
# CRA embeds every REACT_APP_* variable into the public JavaScript bundle,
# so only values that are safe for anyone to see may use that prefix.

# ── Public (browser) ─────────────────────────────────────────────
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
# Supabase publishable/anon key: public by design, safe ONLY with RLS on every table
REACT_APP_SUPABASE_ANON_KEY=sb_publishable_xxx

# ── Server only (Vercel functions in /api) ───────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx
ANTHROPIC_API_KEY=sk-ant-xxx
CRON_SECRET=generate-a-long-random-string
# Optional: comma-separated extra origins allowed to call /api cross-origin
# ALLOWED_ORIGINS=
